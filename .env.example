# ClimateGuard Mannheim MQTT manual probe. Copy to .env and insert broker credentials.
TTN_API_KEY=
MQTT_BROKER=eu1.cloud.thethings.network
MQTT_PORT=8883
MQTT_USERNAME=climateguard@ttn
MQTT_TOPIC=v3/climateguard@ttn/devices/+/up
ENV=prod
QUANTUM_API_KEY=
# Safety gate: keep false until a single-entry write has been explicitly approved.
QUANTUM_WRITE_ENABLED=false

CLIMATEGUARD_TEST_MH_HOST=hsma-iot.de
CLIMATEGUARD_TEST_MH_PORT=8883
CLIMATEGUARD_TEST_MH_USERNAME=
CLIMATEGUARD_TEST_MH_PASSWORD=
CLIMATEGUARD_TEST_MH_TOPIC=climateguard/#
CLIMATEGUARD_TEST_MH_TIMEOUT_SECONDS=60
CLIMATEGUARD_TEST_MH_EXPECTED_SENSORS=Lufft,M1
